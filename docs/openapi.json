{
  "openapi": "3.1.0",
  "info": {
    "title": "Mandi Arbitrage Advisor API",
    "description": "Agricultural commodity market arbitrage advisory backend. Calculates net realization after freight, statutory APMC market cess, agent commission, and produce quality discounts.",
    "version": "0.04.00"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Root Health Check",
        "operationId": "root_health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta/crops": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "List supported crops",
        "description": "Returns canonical list of supported crops with English and Hindi names and query aliases.",
        "operationId": "get_crops_api_v1_meta_crops_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CropsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta/vehicles": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "List vehicle specifications",
        "description": "Returns standard freight vehicles with capacities in quintals and default per-km rates.",
        "operationId": "get_vehicles_api_v1_meta_vehicles_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehiclesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta/rates": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "Get rate card and assumptions",
        "description": "Returns statutory fee defaults, state overrides, vehicle rates, quality cuts, and assumption status flags.",
        "operationId": "get_rates_api_v1_meta_rates_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RatesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta/states": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "List active states",
        "description": "Returns distinct states containing active mandis in the database (cached 1h).",
        "operationId": "get_states_api_v1_meta_states_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta/districts": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "List districts for a state",
        "description": "Returns distinct districts with active mandis for the requested state (cached 1h).",
        "operationId": "get_districts_api_v1_meta_districts_get",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "State name to get districts for",
              "title": "State"
            },
            "description": "State name to get districts for"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DistrictsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/compare": {
      "post": {
        "tags": [
          "Compare"
        ],
        "summary": "Compare mandis by net profit",
        "description": "Resolves origin location, finds candidate mandis within radius with active prices, computes batched road distances, calculates net profit per quintal deducting freight, market fees, and quality cuts, ranks mandis descending by net realization, and returns a detailed comparison breakdown.",
        "operationId": "compare_mandis_api_v1_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful comparison with ranked mandi results, summary, assumptions, and warnings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error (invalid pincode, unknown commodity, or missing location)."
          },
          "429": {
            "description": "Rate limit exceeded (30 requests per minute per IP address)."
          }
        }
      }
    },
    "/api/v1/trend": {
      "get": {
        "tags": [
          "Trend"
        ],
        "summary": "Fetch mandi historical price trends",
        "description": "Returns daily historical modal, min, and max price series for requested mandi IDs over the specified number of days (default 7, max 30). Missing days contain null values (gaps are never interpolated).",
        "operationId": "get_price_trend_api_v1_trend_get",
        "parameters": [
          {
            "name": "mandi_ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Comma-separated mandi IDs, e.g. 1,2,3",
              "title": "Mandi Ids"
            },
            "description": "Comma-separated mandi IDs, e.g. 1,2,3"
          },
          {
            "name": "commodity",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Commodity canonical name, e.g. Wheat",
              "title": "Commodity"
            },
            "description": "Commodity canonical name, e.g. Wheat"
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 30,
              "minimum": 1,
              "description": "Number of historical days (default: 7)",
              "default": 7,
              "title": "Days"
            },
            "description": "Number of historical days (default: 7)"
          }
        ],
        "responses": {
          "200": {
            "description": "Historical price series per mandi.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrendResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid mandi IDs or parameter format."
          }
        }
      }
    },
    "/api/v1/admin/ingest": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Trigger Ingest",
        "operationId": "trigger_ingest_api_v1_admin_ingest_post",
        "parameters": [
          {
            "name": "X-Admin-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Admin-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "V1 Health Check",
        "operationId": "v1_health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
