# Environment: development | test | production
ENV=development

# Database connection URL (SQLite with aiosqlite locally, Postgres with asyncpg in production)
DATABASE_URL=sqlite+aiosqlite:///./mandi.db

# data.gov.in API key for fetching daily mandi prices
DATA_GOV_API_KEY=your_datagov_api_key_here

# data.gov.in Mandi Price Resource ID
DATAGOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Google Cloud API Key (with Geocoding API and Routes API enabled)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Secret token for admin endpoints (e.g., POST /api/v1/admin/ingest via X-Admin-Token header)
ADMIN_TOKEN=change_this_to_a_secure_token

# Allowed CORS frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Geographic search radius in kilometers
MAX_RADIUS_KM=150

# Maximum age of mandi prices in days before being flagged as stale or excluded
PRICE_MAX_AGE_DAYS=3

# Number of days for price history trend series
TREND_DAYS=7
